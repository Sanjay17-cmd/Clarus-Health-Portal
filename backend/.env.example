# ── Clarus Health Portal — Backend Environment ──

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=clarus_health

# JWT
JWT_SECRET=clarus_health_jwt_secret_change_in_production
JWT_EXPIRES_IN=24h

# Server
PORT=5000
NODE_ENV=development

# Upload limits
MAX_FILE_SIZE=10485760
